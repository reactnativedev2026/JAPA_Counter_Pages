<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Happy Birthday Wishes GIF — Wish out loud, in motion</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #241536;
    --bg-alt: #2F1B47;
    --panel: #34204C;
    --pink: #FF5D8F;
    --gold: #FFC15E;
    --text: #F5EFFF;
    --muted: #C7B4E3;
    --line: rgba(245,239,255,0.12);
    --radius: 22px;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:
      radial-gradient(circle at 12% 8%, rgba(255,93,143,0.16), transparent 40%),
      radial-gradient(circle at 88% 14%, rgba(255,193,94,0.14), transparent 45%),
      var(--bg);
    color:var(--text);
    font-family:'Manrope', sans-serif;
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3, .display{ font-family:'Baloo 2', sans-serif; }
  a{color:inherit; text-decoration:none;}
  .wrap{max-width:1160px; margin:0 auto; padding:0 28px;}

  /* ---------- confetti ambient ---------- */
  .confetti{position:fixed; inset:0; pointer-events:none; z-index:0; overflow:hidden;}
  .confetti span{
    position:absolute; top:-40px; border-radius:3px; opacity:0.55;
    animation: fall linear infinite;
  }
  @keyframes fall{
    to{ transform: translateY(110vh) rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce){
    .confetti span{ animation:none; display:none; }
  }

  /* ---------- nav ---------- */
  header{
    position:sticky; top:0; z-index:20;
    backdrop-filter: blur(10px);
    background: rgba(36,21,54,0.72);
    border-bottom:1px solid var(--line);
  }
  nav{ display:flex; align-items:center; justify-content:space-between; padding:18px 0;}
  .brand{ display:flex; align-items:center; gap:10px; font-family:'Baloo 2'; font-weight:700; font-size:1.15rem;}
  .brand-mark{
    width:34px; height:34px; border-radius:10px;
    background: linear-gradient(135deg, var(--pink), var(--gold));
    display:flex; align-items:center; justify-content:center; font-size:18px;
    box-shadow: 0 6px 16px rgba(255,93,143,0.35);
  }
  .nav-links{ display:flex; gap:28px; font-size:0.92rem; color:var(--muted); }
  .nav-links a:hover{ color:var(--text); }
  .nav-cta{
    background:var(--gold); color:#2A1735; font-weight:700; padding:10px 18px;
    border-radius:999px; font-size:0.9rem;
  }
  @media (max-width:720px){ .nav-links{display:none;} }

  /* ---------- hero ---------- */
  .hero{ position:relative; z-index:1; padding:76px 0 60px; }
  .hero-grid{ display:grid; grid-template-columns:1.05fr 0.95fr; gap:48px; align-items:center;}
  @media (max-width:900px){ .hero-grid{grid-template-columns:1fr;} }
  .eyebrow{
    display:inline-flex; align-items:center; gap:8px;
    font-size:0.82rem; letter-spacing:0.06em; color:var(--gold);
    background:rgba(255,193,94,0.1); border:1px solid rgba(255,193,94,0.3);
    padding:7px 14px; border-radius:999px; margin-bottom:20px; font-weight:600;
  }
  .hero h1{
    font-size:clamp(2.4rem, 5vw, 3.7rem); line-height:1.06; font-weight:800;
    letter-spacing:-0.01em;
  }
  .hero h1 .accent{ color:var(--pink); }
  .hero p.lede{
    margin-top:22px; font-size:1.12rem; color:var(--muted); max-width:480px; line-height:1.6;
  }
  .hero-ctas{ display:flex; gap:14px; margin-top:32px; flex-wrap:wrap; }
  .btn-primary, .btn-ghost{
    padding:14px 24px; border-radius:14px; font-weight:700; font-size:0.98rem;
    display:inline-flex; align-items:center; gap:10px;
  }
  .btn-primary{
    background: linear-gradient(135deg, var(--pink), #FF8A65);
    color:#fff; box-shadow:0 12px 30px rgba(255,93,143,0.35);
  }
  .btn-ghost{ border:1px solid var(--line); color:var(--text); }
  .btn-primary:hover{ transform:translateY(-2px); }
  .rating-row{ display:flex; align-items:center; gap:10px; margin-top:26px; color:var(--muted); font-size:0.9rem;}
  .stars{ color:var(--gold); letter-spacing:2px; }

  /* ---------- signature: fanned GIF card stack ---------- */
  .fan{
    position:relative; height:420px; display:flex; align-items:center; justify-content:center;
  }
  .fan-card{
    position:absolute; width:190px; height:250px; border-radius:20px;
    padding:16px; display:flex; flex-direction:column; justify-content:space-between;
    box-shadow: 0 20px 40px rgba(0,0,0,0.35);
    border:1px solid rgba(255,255,255,0.12);
    animation: sway 6s ease-in-out infinite;
  }
  .fan-card .tag{ font-size:0.78rem; font-weight:700; opacity:0.85; }
  .fan-card .glyph{ font-size:2.6rem; align-self:center; }
  .fan-card .cap{ font-family:'Baloo 2'; font-weight:700; font-size:1.05rem; }
  .fan-card:nth-child(1){ background:linear-gradient(160deg,#FF5D8F,#B33D68); transform:rotate(-14deg) translate(-92px,10px); z-index:1; animation-delay:0s;}
  .fan-card:nth-child(2){ background:linear-gradient(160deg,#7B4B94,#4B2A63); transform:rotate(-3deg) translate(0,-14px); z-index:3; animation-delay:0.4s;}
  .fan-card:nth-child(3){ background:linear-gradient(160deg,#FFC15E,#E08A2B); color:#2A1735; transform:rotate(11deg) translate(92px,10px); z-index:2; animation-delay:0.8s;}
  @keyframes sway{
    0%,100%{ translate: 0 0; } 50%{ translate: 0 -8px; }
  }
  @media (prefers-reduced-motion: reduce){ .fan-card{ animation:none; } }
  @media (max-width:900px){ .fan{ height:340px; } .fan-card{ width:150px; height:200px; } }

  /* ---------- section shell ---------- */
  section{ position:relative; z-index:1; padding:80px 0; }
  .section-head{ max-width:620px; margin-bottom:44px; }
  .kicker{ color:var(--pink); font-weight:700; font-size:0.85rem; letter-spacing:0.08em; text-transform:uppercase; }
  .section-head h2{ font-size:clamp(1.8rem,3.4vw,2.5rem); margin-top:10px; font-weight:700; }
  .section-head p{ color:var(--muted); margin-top:14px; line-height:1.6; }

  /* ---------- features bento ---------- */
  .bento{ display:grid; grid-template-columns:repeat(4, 1fr); grid-auto-rows:170px; gap:18px; }
  .bento .card{
    background:var(--panel); border:1px solid var(--line); border-radius:var(--radius);
    padding:24px; display:flex; flex-direction:column; justify-content:space-between;
    transition: border-color .2s, transform .2s;
  }
  .bento .card:hover{ border-color:rgba(255,93,143,0.4); transform:translateY(-3px); }
  .bento .card .icon{ font-size:1.6rem; }
  .bento .card h3{ font-size:1.05rem; font-weight:600; }
  .bento .card p{ color:var(--muted); font-size:0.87rem; line-height:1.5; }
  .b1{ grid-column:span 2; grid-row:span 2; }
  .b2{ grid-column:span 2; }
  .b3{ grid-column:span 1; }
  .b4{ grid-column:span 1; }
  .b5{ grid-column:span 2; }
  @media (max-width:900px){
    .bento{ grid-template-columns:repeat(2,1fr); grid-auto-rows:auto;}
    .b1,.b2,.b3,.b4,.b5{ grid-column:span 2; grid-row:auto; }
  }

  /* ---------- how it works ---------- */
  .steps{ display:grid; grid-template-columns:repeat(4,1fr); gap:20px; counter-reset:step; }
  @media (max-width:900px){ .steps{ grid-template-columns:1fr 1fr; } }
  @media (max-width:520px){ .steps{ grid-template-columns:1fr; } }
  .step{ position:relative; padding-top:6px; }
  .step .num{
    font-family:'Baloo 2'; font-weight:800; font-size:2.4rem;
    background:linear-gradient(135deg,var(--pink),var(--gold));
    -webkit-background-clip:text; background-clip:text; color:transparent;
    line-height:1;
  }
  .step h3{ margin-top:10px; font-size:1.05rem; font-weight:700; }
  .step p{ color:var(--muted); font-size:0.87rem; margin-top:6px; line-height:1.5; }
  .step:not(:last-child)::after{
    content:''; position:absolute; top:22px; right:-14px; width:24px; height:2px;
    background:repeating-linear-gradient(90deg, var(--muted) 0 6px, transparent 6px 10px);
    opacity:0.5;
  }
  @media (max-width:900px){ .step::after{ display:none; } }

  /* ---------- who it's for ---------- */
  .chips{ display:flex; flex-wrap:wrap; gap:12px; }
  .chip{
    background:var(--panel); border:1px solid var(--line); padding:12px 20px;
    border-radius:999px; font-size:0.92rem; display:flex; align-items:center; gap:8px;
  }

  /* ---------- CTA footer ---------- */
  .cta-panel{
    background: linear-gradient(135deg, #3A2153, #4A2A63 60%, #5A2D5B);
    border-radius:32px; padding:64px 44px; text-align:center; position:relative; overflow:hidden;
    border:1px solid rgba(255,255,255,0.08);
  }
  .cta-panel h2{ font-size:clamp(1.9rem,4vw,2.6rem); }
  .cta-panel p{ color:var(--muted); margin-top:14px; max-width:460px; margin-inline:auto; }
  .cta-panel .hero-ctas{ justify-content:center; margin-top:30px; }
  .play-badge{
    display:inline-flex; align-items:center; gap:10px; background:#000; color:#fff;
    padding:12px 20px; border-radius:12px; font-weight:600; border:1px solid rgba(255,255,255,0.2);
  }
  .play-badge .glyph{ font-size:1.4rem; }
  .play-badge small{ display:block; font-weight:400; font-size:0.7rem; opacity:0.75; }

  footer{ padding:36px 0 60px; text-align:center; color:var(--muted); font-size:0.85rem; }
  footer a{ color:var(--gold); }
</style>
</head>
